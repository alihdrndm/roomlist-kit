{
  "name": "@alihdrndm/roomlist-cli",
  "version": "0.1.0",
  "description": "Command-line interface for roomlist-kit",
  "author": "Ali Haider Nadeem",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "roomlist": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @alihdrndm/roomlist-core build && tsc -p tsconfig.build.json && vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "execa": "^10.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@alihdrndm/roomlist-core": "workspace:*",
    "commander": "^15.0.0"
  }
}
