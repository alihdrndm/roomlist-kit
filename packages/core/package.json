{
  "name": "@alihdrndm/roomlist-core",
  "version": "0.1.0",
  "description": "Parse, validate and export hotel rooming lists",
  "author": "Ali Haider Nadeem",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@alihdrndm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plain-date": {
      "@alihdrndm/source": "./src/plain-date.ts",
      "types": "./dist/plain-date.d.ts",
      "default": "./dist/plain-date.js"
    },
    "./rules": {
      "@alihdrndm/source": "./src/issues.ts",
      "types": "./dist/issues.d.ts",
      "default": "./dist/issues.js"
    },
    "./header-aliases": {
      "@alihdrndm/source": "./src/parse/header-aliases.ts",
      "types": "./dist/parse/header-aliases.d.ts",
      "default": "./dist/parse/header-aliases.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.5",
    "csv-parse": "^7.0.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.7"
  }
}
