# Copy to .env for local development. Every variable has a safe default.

# Port the API listens on.
PORT=4010
# Shared secret for the /v1 endpoints (x-api-key header). Empty disables authentication (development only).
API_KEY=
# Largest accepted upload, in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880
# Most data rows accepted in one rooming list.
MAX_ROWS=5000
# Number of reverse proxies in front of the API (0 = none). Set to 1 behind a load balancer so the rate limit sees each client.
TRUST_PROXY=0
# development: readable logs. production: JSON lines. test: JSON lines.
NODE_ENV=development
# Where the web app finds the API (server-side only).
API_BASE_URL=http://localhost:4010
