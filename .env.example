# Port the NestJS API listens on.
PORT=4010
# Shared secret for the x-api-key header; leave empty to disable auth (development only).
API_KEY=
# Maximum accepted upload size in bytes (5 MiB).
MAX_UPLOAD_BYTES=5242880
# Maximum number of data rows accepted per rooming list.
MAX_ROWS=5000
# Base URL the Next.js server uses to call the API (server-only).
API_BASE_URL=http://localhost:4010
